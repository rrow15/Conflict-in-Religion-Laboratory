---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const allNews = await getCollection("news");

const sortedNews = allNews.sort((a, b) => {
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const selectedType = Astro.url.searchParams.get("type");

const news = selectedType
    ? sortedNews.filter((item) => item.data.type === selectedType)
    : sortedNews;

const types = [
    "Announcement",
    "Events & Activities",
    "Celebration",
    "Congratulations",
];
---

<BaseLayout title="News | CORE">
    <div class="news-page">
        <header class="page-header">
            <h1 class="page-title">News</h1>

            <p class="page-subtitle">
                Updates, activities, and celebrations from CORE.
            </p>
        </header>

        <div class="news-list">
            {
                news.map(async (item) => {
                    const { Content } = await render(item);

                    return (
                        <article
                            class:list={[
                                "news-item",
                                { "has-image": item.data.image },
                            ]}
                        >
                            {item.data.image && (
                                <div class="news-image">
                                    <img
                                        src={item.data.image}
                                        alt=""
                                        loading="lazy"
                                    />
                                </div>
                            )}

                            <div class="news-content">
                                <div class="news-meta">
                                    <time datetime={item.data.date}>
                                        {new Date(
                                            item.data.date,
                                        ).toLocaleDateString("en-US", {
                                            year: "numeric",
                                            month: "long",
                                            day: "numeric",
                                        })}
                                    </time>

                                    <span>·</span>
                                    
                                    <a
                                        class="news-type"
                                        /*href={`/news?type=${encodeURIComponent(item.data.type)}`}*/
                                    >
                                        {item.data.type}
                                    </a>
                                    
                                </div>

                                <h2>{item.data.title}</h2>

                                <div class="news-body">
                                    <Content />
                                </div>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </div>
</BaseLayout>

<style>
    .news-page {
        max-width: 950px;
        margin: 0 auto;
    }

    /* NEWS LIST */

    .news-list {
        display: flex;
        flex-direction: column;
    }

    /* INDIVIDUAL NEWS ITEM */

    .news-item {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;

        padding: 2.5rem 0;

        border-bottom: 1px solid var(--border);
    }

    .news-item:first-child {
        padding-top: 0;
    }
    .news-item.has-image {
        grid-template-columns: 260px 1fr;
    }

    /* IMAGE */

    .news-image {
        width: 100%;
        aspect-ratio: 4 / 3;

        overflow: hidden;
        border-radius: 10px;
    }

    .news-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* CONTENT */

    .news-content {
        align-self: center;
    }

    .news-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;

        margin-bottom: 0.65rem;

        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .news-type {
        display: inline-block;

        padding: 0.2rem 0.55rem;

        border: 1px solid var(--border);
        border-radius: 999px;

        color: var(--text-muted);
        text-decoration: none;

        font-size: 0.7rem;

        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .news-type:hover {
        color: inherit;
        background: var(--surface);
    }

    .news-content h2 {
        margin: 0 0 0.75rem;

        font-size: 1.5rem;
        line-height: 1.3;
    }

    .news-body {
        color: var(--text-muted);
        line-height: 1.7;
    }

    .news-body :global(p) {
        margin: 0;
    }

    /* MOBILE */

    @media (max-width: 700px) {
        .news-item.has-image {
            grid-template-columns: 1fr;
        }

        .news-image {
            aspect-ratio: 16 / 9;
        }
    }
</style>
