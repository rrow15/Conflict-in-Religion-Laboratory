---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("research");

    return projects.map((project) => ({
        params: {
            slug: project.id,
        },
        props: {
            project,
        },
    }));
}

const { project } = Astro.props;

const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | CORE`}>
    <article class="project">

        <h1>{project.data.title}</h1>

        <p class="status">
            <strong>Status:</strong> {project.data.status}
        </p>

        {
            project.data.researchers &&
            project.data.researchers.length > 0 && (
                <>
                    <h2>Researchers</h2>

                    <ul>
                        {project.data.researchers.map((researcher) => (
                            <li>{researcher}</li>
                        ))}
                    </ul>
                </>
            )
        }

        <Content />

    </article>

    <style>
        .project {
            max-width: 900px;
        }

        .status {
            margin-bottom: 2rem;
            font-size: 1.05rem;
        }

        h2 {
            margin-top: 2.5rem;
        }

        ul {
            padding-left: 1.5rem;
        }
    </style>
</BaseLayout>