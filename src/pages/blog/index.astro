---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

posts.sort((a, b) => {
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout title="Blog | CORE">
    <div class="blog-page">
        <header class="page-header">
            <h1 class="page-title">Blog</h1>

            <p class="page-subtitle">
                Reflections, research notes, and perspectives from CORE.
            </p>
        </header>

        <div class="posts">
            {
                posts.map((post) => (
                    <article class="post">
                        {post.data.image && (
                            <a href={`${import.meta.env.BASE_URL}/blog/${post.id}`} class="post-image">
                                <img
                                    src={`${import.meta.env.BASE_URL}${post.data.image}`}
                                    alt=""
                                    loading="lazy"
                                />
                            </a>
                        )}

                        <div class="post-content">
                            <div class="post-meta">
                                <time datetime={post.data.date}>
                                    {new Date(
                                        post.data.date,
                                    ).toLocaleDateString("en-US", {
                                        year: "numeric",
                                        month: "long",
                                        day: "numeric",
                                    })}
                                </time>

                                {post.data.author && (
                                    <>
                                        <span> · </span>
                                        <span>{post.data.author}</span>
                                    </>
                                )}
                            </div>

                            <h2>
                                <a href={`${import.meta.env.BASE_URL}/blog/${post.id}`}
                                
                                    {post.data.title}
                                </a>
                            </h2>

                            {post.data.description && (
                                <p class="description">
                                    {post.data.description}
                                </p>
                            )}

                            {post.data.tags && post.data.tags.length > 0 && (
                                <div class="tags">
                                    {post.data.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                            )}
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</BaseLayout>

<style>
    .blog-page {
        max-width: 1050px;
        margin: 0 auto;
    }

    /*.blog-header {
    margin-bottom: 4rem;
    max-width: 750px;
}

.eyebrow {
    margin-bottom: .75rem;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
}

.blog-header h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
}

.blog-header > p:last-child {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-muted);
}
*/
    .posts {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .post {
        display: grid;
        grid-template-columns: minmax(280px, 42%) 1fr;
        gap: 2.5rem;
        padding-bottom: 4rem;
        border-bottom: 1px solid var(--border);
    }

    .post-image {
        display: block;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 12px;
    }

    .post-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .post-image:hover img {
        transform: scale(1.03);
    }

    .post-content {
        align-self: center;
    }

    .post-meta {
        margin-bottom: 0.75rem;
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .post-content h2 {
        margin: 0 0 1rem;
        font-size: 1.8rem;
        line-height: 1.25;
    }

    .post-content h2 a {
        color: inherit;
        text-decoration: none;
    }

    .post-content h2 a:hover {
        color: var(--accent);
    }

    .description {
        margin: 0 0 1.25rem;
        line-height: 1.7;
        color: var(--text-muted);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tags span {
        padding: 0.3rem 0.65rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    @media (max-width: 700px) {
        .post {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .post-content h2 {
            font-size: 1.5rem;
        }
    }
</style>
