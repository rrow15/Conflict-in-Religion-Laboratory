---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {

    const posts = await getCollection("posts");

    return posts.map((post) => ({
        params: {
            slug: post.id,
        },
        props: {
            post,
        },
    }));
}

const { post } = Astro.props;

const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | CORE`}>

    <article class="article">

        {post.data.image && (
            <img
                class="hero-image"
                src={`${import.meta.env.BASE_URL}${post.data.image}`}
                alt=""
            />
        )}

        <header class="article-header">

            <div class="meta">

                <time datetime={post.data.date}>
                    {new Date(post.data.date).toLocaleDateString(
                        "en-US",
                        {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        }
                    )}
                </time>

                {post.data.author && (
                    <>
                        <span> · </span>
                        <span>{post.data.author}</span>
                    </>
                )}

            </div>

            <h1>{post.data.title}</h1>

            {post.data.description && (
                <p class="description">
                    {post.data.description}
                </p>
            )}

            {post.data.tags && post.data.tags.length > 0 && (
                <div class="tags">
                    {post.data.tags.map((tag) => (
                        <span>{tag}</span>
                    ))}
                </div>
            )}

        </header>


        <div class="prose">
            <Content />
        </div>

    </article>

</BaseLayout>


<style>
.article {
    max-width: 850px;
    margin: 0 auto;
}

.hero-image {
    width: 100%;
    max-height: 550px;
    object-fit: cover;
    border-radius: 14px;
    margin-bottom: 3rem;
}

.article-header {
    margin-bottom: 3rem;
}

.meta {
    margin-bottom: 1rem;
    font-size: .9rem;
    color: var(--text-muted);
}

.article-header h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.3rem, 6vw, 4rem);
    line-height: 1.1;
}

.description {
    max-width: 750px;
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-muted);
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: 1.5rem;
}

.tags span {
    padding: .3rem .65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: .75rem;
}

.prose {
    line-height: 1.85;
}

.prose :global(h2) {
    margin-top: 3rem;
}

.prose :global(img) {
    width: 100%;
    border-radius: 10px;
    margin: 2rem 0;
}
</style>